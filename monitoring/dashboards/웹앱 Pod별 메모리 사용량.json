{
  "kind": "Panel",
  "spec": {
    "id": 4,
    "title": "웹앱 Pod별 메모리 사용량",
    "description": "chicken-app Pod별 컨테이너 메모리 working set을 합산하여 표시한다.",
    "links": [],
    "data": {
      "kind": "QueryGroup",
      "spec": {
        "queries": [
          {
            "kind": "PanelQuery",
            "spec": {
              "refId": "A",
              "hidden": false,
              "query": {
                "kind": "DataQuery",
                "group": "prometheus",
                "version": "v0",
                "datasource": { "name": "prometheus" },
                "spec": {
                  "editorMode": "code",
                  "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"chicken-app\", pod=~\"chicken-app-.*\", container!=\"\", container!=\"POD\", image!=\"\"})",
                  "legendFormat": "{{pod}}",
                  "range": true
                }
              }
            }
          }
        ],
        "transformations": [],
        "queryOptions": {}
      }
    },
    "vizConfig": {
      "kind": "VizConfig",
      "group": "timeseries",
      "version": "13.2.4",
      "spec": {
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "decimals": 1,
            "min": 0
          },
          "overrides": []
        }
      }
    }
  }
}